# ===== Konfigurasi bot (salin file ini jadi .env lalu isi) =====

# Token bot dari @BotFather (contoh: 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=

# Telegram User ID Anda (dari @userinfobot). HANYA ID ini yang boleh memakai bot.
ALLOWED_USER_ID=

# Token langganan Claude dari perintah: claude setup-token  (berlaku ~1 tahun)
CLAUDE_CODE_OAUTH_TOKEN=

# PENTING: JANGAN set ANTHROPIC_API_KEY di sini.
# Kalau di-set, ia akan menimpa token langganan di atas.
